{"kind":"textbox","id":"sh/x4r21kru","slideIndex":1,"position":{"left":88,"top":193.07,"width":1104,"height":456.83},"name":"内容占位符 2","text":"AI玩偶硬件端侧与协同软件端小程序开发、迭代\n版本Roadmap规划与产品调研\n机器人及智能硬件竞品调研\n端侧体验优化、功能上线、版本发布与跨团队项目推进","style":{"fontSize":27,"typeface":"Arial","color":"#000000","alignment":"left"}}
